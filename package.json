{
  "name": "desi-overdrive-bangla-drift",
  "private": true,
  "version": "6.0.0",
  "description": "DESI OVERDRIVE: BANGLA DRIFT - Three.js + Rapier open-world arcade racer (Bengali comedy tone)",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "npm run build:web",
    "build:android": "vite build",
    "build:singlefile": "BUILD_MODE=singlefile vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node tools/smoke_test.mjs",
    "build:web": "vite build",
    "android:add": "npx cap add android",
    "android:sync": "npm run build:web && npx cap sync android",
    "android:apk:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:aab:release": "npm run android:sync && cd android && ./gradlew bundleRelease",
    "android:open": "npx cap open android",
    "test:browser": "node tools/browser_smoke.mjs",
    "test:playthrough": "node tools/browser_playthrough.mjs",
    "test:production": "node tools/production_smoke.mjs",
    "test:practice": "node tools/browser_practice.mjs",
    "test:pause": "node tools/browser_pause.mjs",
    "test:diagnostics": "node tools/browser_diagnostics.mjs",
    "test:voice": "node tools/browser_voice.mjs",
    "test:storage": "node tools/browser_storage.mjs",
    "test:motion": "node tools/browser_motion.mjs",
    "test:announcements": "node tools/browser_announcements.mjs",
    "test:offline": "node tools/production_offline.mjs",
    "test:keyboard": "node tools/browser_keyboard.mjs",
    "test:targets": "node tools/browser_targets.mjs",
    "test:hud": "node tools/browser_hud.mjs",
    "test:combo": "node tools/browser_combo.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@dimforge/rapier3d-compat": "^0.14.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "puppeteer": "^25.17.0",
    "terser": "^5.36.0",
    "vite": "^6.4.6",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
