{
  "name": "desi-overdrive-bangla-drift",
  "private": true,
  "version": "6.0.0",
  "description": "DESI OVERDRIVE: BANGLA DRIFT - Three.js + Rapier open-world arcade racer (Bengali comedy tone)",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "npm run build:web",
    "build:android": "vite build",
    "build:singlefile": "BUILD_MODE=singlefile vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node tools/smoke_test.mjs",
    "build:web": "vite build",
    "android:add": "npx cap add android",
    "android:sync": "npm run build:web && npx cap sync android",
    "android:apk:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:aab:release": "npm run android:sync && cd android && ./gradlew bundleRelease",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@dimforge/rapier3d-compat": "^0.14.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "puppeteer": "^24.43.1",
    "terser": "^5.36.0",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
