{
  "appId": "com.desioverdrive.bangladrift",
  "appName": "Desi Overdrive: Bangla Drift",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "backgroundColor": "#0b0f18",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "LIGHT"
    },
    "KeepAwake": {
      "autoResume": true
    }
  }
}
